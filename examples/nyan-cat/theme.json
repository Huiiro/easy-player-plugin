{
  "version": 1,
  "colorMode": "dark",
  "accentColor": "#f3a7d3",
  "headerBackground": "#21182fe8",
  "footerBackground": "#2a203ceF",
  "chromeBorder": "#c298d647",
  "background": "#191329",
  "tokens": {
    "--color-primary": "#f3a7d3",
    "--color-primary-fill": "#f3a7d3",
    "--color-on-primary": "#302039",
    "--color-text": "#f8f1ff",
    "--color-text-l": "#c5b8dc",
    "--color-text-l2": "#a090bd",
    "--color-text-l3": "#77648f",
    "--color-bg": "#191329",
    "--color-bg-l": "#281f3d",
    "--color-bg-l2": "#34294c",
    "--color-bg-d": "#100d1f",
    "--color-border": "#67537d",
    "--color-border-l": "#997fab",
    "--color-hover": "#e8b7ff18",
    "--color-hover-bg": "#473353",
    "--color-icon": "#ead8f7",
    "--color-icon-l": "#bba5cd",
    "--color-danger": "#ff90ac",
    "--color-success": "#9de6b5",
    "--color-warning": "#ffe58d",
    "--btn-primary-bg": "#f3a7d3",
    "--btn-primary-text": "#302039",
    "--btn-primary-bg-hover": "#ffc8e4",
    "--btn-primary-ring": "#b3e7e3",
    "--btn-danger-bg": "#583349",
    "--btn-danger-text": "#ffccdf",
    "--btn-danger-bg-hover": "#704158",
    "--app-header-bg": "#21182fe8",
    "--app-footer-bg": "#2a203ceF",
    "--app-chrome-border": "#c298d647",
    "--ep-sidebar-bg": "#21182fc9",
    "--ep-sidebar-text": "#d9c9eb",
    "--ep-sidebar-active-bg": "#d5b6ff26",
    "--ep-sidebar-active-text": "#f7c6e8",
    "--ep-sidebar-item-radius": "14px",
    "--ep-button-radius": "999px",
    "--ep-dialog-bg": "#2b203d",
    "--ep-dialog-radius": "24px",
    "--ep-overlay-bg": "#100b24b8",
    "--ep-surface-shadow": "0 16px 60px #07051266, 0 0 0 1px #d4afe638",
    "--ep-progress-track": "#53415f",
    "--ep-progress-fill": "#f3a7d3",
    "--ep-progress-thumb": "#ffe4f1",
    "--ep-range-track-height": "8px",
    "--ep-range-thumb-width": "60px",
    "--ep-range-thumb-height": "36px",
    "--ep-range-thumb-radius": "0px",
    "--ep-range-thumb-bg": "transparent",
    "--ep-range-fill-background": "linear-gradient(to bottom, #ff809f 0% 16.666666666666668%, #ffbd78 16.666666666666668% 33.333333333333336%, #ffe58d 33.333333333333336% 50%, #9de6b5 50% 66.66666666666667%, #87cefa 66.66666666666667% 83.33333333333333%, #c3a1ff 83.33333333333333% 100%)",
    "--ep-switch-active": "#c7b4f5",
    "--ep-switch-inactive": "#69547e",
    "--scrollbar-track": "transparent",
    "--scrollbar-thumb": "#725a89",
    "--scrollbar-thumb-hover": "#c5a3df"
  },
  "rules": {
    ".ep-playback-progress": {
      "height": "36px"
    },
    ".ep-sidebar-item--active": {
      "box-shadow": "inset 3px 0 0 #f3a7d3"
    },
    ".ep-button--primary": {
      "box-shadow": "0 4px 16px #f3a7d324"
    },
    ".ep-dialog-title": {
      "color": "#f7c6e8"
    },
    ".ep-dialog-header": {
      "border-bottom": "1px solid #c298d633"
    },
    ".ep-dialog-footer": {
      "border-top": "1px solid #c298d633"
    },
    ".ep-input": {
      "border-radius": "10px"
    },
    ".ep-footer": {
      "border-radius": "24px"
    }
  },
  "assets": {
    "resources": {
      "cute": {
        "type": "font",
        "path": "fonts/kuaile.ttf",
        "weight": "400"
      },
      "cat": {
        "type": "image",
        "path": "images/nyan-cat.png"
      },
      "sky": {
        "type": "image",
        "path": "images/starfield.png"
      }
    },
    "slots": {
      "global": {
        "font": "cute"
      },
      "appBackground": {
        "image": "sky"
      },
      "playbackThumb": {
        "image": "cat"
      }
    },
    "text": {
      "appTitle": "Nyan Player",
      "homeWelcome": "Nyan~ 今天也要开心听歌喵！"
    },
    "licenses": [
      "fonts/OFL.txt"
    ]
  }
}
